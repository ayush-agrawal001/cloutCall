# Copy to .env.local. Names only: never commit real values.
# The NEXT_PUBLIC_* contract values can be generated with: node scripts/sync-env.mjs <chainId>

# ---- public (shipped to the browser) ----
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_MARKET_ADDRESS=
NEXT_PUBLIC_POINTS_ADDRESS=
NEXT_PUBLIC_START_BLOCK=
NEXT_PUBLIC_JOURNAL_ADDRESS=
NEXT_PUBLIC_AGENT_ADDRESS=
# Comma-separated house liquidity bot addresses (resolver: npm run bots -- --status); labelled and never ranked
NEXT_PUBLIC_HOUSE_BOTS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
# Optional: override the chain's default RPC / WebSocket endpoints
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WS_URL=
# Final public origin (OG images, OAuth redirect), e.g. the production domain
NEXT_PUBLIC_SITE_URL=
# Optional: Envio HyperIndex GraphQL endpoint for leaderboard stats
NEXT_PUBLIC_ENVIO_URL=

# ---- server-only secrets ----
# Gas drip for new accounts (/api/drip)
DRIP_PRIVATE_KEY=
DRIP_AMOUNT=
DRIP_IP_LIMIT=
# Live view counts (/api/views)
YOUTUBE_API_KEY=
# Optional: override the YouTube Data API endpoint (local tests)
YOUTUBE_API_BASE=
# Creator mode (Google OAuth, youtube.readonly) and on-chain attestation
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CREATOR_STATE_SECRET=
VERIFIER_PRIVATE_KEY=
